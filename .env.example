# Resend API key used to send contact emails.
# Leave empty to simulate delivery locally (dev only) or to get 503 in production.
RESEND_API_KEY=

# Destination inbox that receives contact messages.
CONTACT_TO_EMAIL=nikhilkottoli2005@gmail.com

# Sender address shown on outgoing emails.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional comma-separated list of origins allowed to call /api/contact.
# Unset: only localhost/127.0.0.1 (and VERCEL_URL in production) are allowed.
CONTACT_ALLOWED_ORIGINS=

# Optional Upstash Redis REST credentials used for a shared global rate limit counter.
# Unset: rate limiting falls back to the in-process memory backend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
